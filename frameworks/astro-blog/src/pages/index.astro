---
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = await Astro.glob('./posts/*.md');
const sortedPosts = allPosts.sort((a, b) =>
  new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf()
);
---

<BaseLayout>
  <h1>Bem-vindo</h1>
  <p>Um blog minimalista com modo escuro.</p>

  <h2 style="margin-top: 3rem;">Posts Recentes</h2>
  {sortedPosts.length === 0 ? (
    <p>Nenhum post ainda. Adicione seus posts em <code>src/pages/posts/</code></p>
  ) : (
    <ul class="post-list">
      {sortedPosts.map((post) => (
        <li class="post-item">
          <div class="post-date">{new Date(post.frontmatter.date).toLocaleDateString('pt-BR')}</div>
          <h3 class="post-title">
            <a href={post.url}>{post.frontmatter.title}</a>
          </h3>
          {post.frontmatter.description && (
            <p class="post-excerpt">{post.frontmatter.description}</p>
          )}
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
